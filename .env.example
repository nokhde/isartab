# Copy to .env and adjust. All variables are optional — the app runs with
# sensible defaults if none are set. The real .env is git-ignored.

# Public base URL of the deployment, no trailing slash. Used in share links
# and QR codes. Default: http://localhost:8000
BASE_URL=https://debate.example.org

# Free-form Impressum block shown verbatim on /legal. Newlines are preserved,
# so quote the value and let it span multiple lines. When unset, /legal shows
# a placeholder listing the legally required fields. Default: empty
IMPRINT_TEXT="Debattierclub Musterstadt e.V.
c/o Mustermann
Musterstraße 1
12345 Musterstadt

Kontakt:
    E-Mail: vorstand@example.org"

# Log every accepted registration/modification to stdout so the history can be
# reconstructed from the container logs (the DB is in-memory only and wiped on
# restart). NOTE: this writes participant names and free-text requests —
# personal data — to the logs; keep log retention short. Default: true.
# Set to false / 0 / no / off to disable.
LOG_REGISTRATIONS=true
